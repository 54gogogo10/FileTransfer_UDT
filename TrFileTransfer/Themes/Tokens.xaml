<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark theme design tokens. Every color used by controls lives here; a future
      light theme only needs to swap the values in this file.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FF17191F"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#FF1F232C"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#FF2A2F3A"/>
    <SolidColorBrush x:Key="Brush.CardInner" Color="#FF1A1E26"/>
    <SolidColorBrush x:Key="Brush.ItemCard" Color="#FF2A303C"/>
    <SolidColorBrush x:Key="Brush.ItemCardBorder" Color="#FF343B4B"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Brush.AccentDown" Color="#FF1D4ED8"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF3F4F6"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF9CA3AF"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FF5B6270"/>

    <!-- Inputs & interactive fills -->
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FF262B36"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#FF343B4B"/>
    <SolidColorBrush x:Key="Brush.HoverFill" Color="#FF2A303C"/>
    <SolidColorBrush x:Key="Brush.DownFill" Color="#FF323949"/>
    <SolidColorBrush x:Key="Brush.SelBg" Color="#FF243550"/>

    <!-- Log console -->
    <SolidColorBrush x:Key="Brush.LogBg" Color="#FF121419"/>
    <SolidColorBrush x:Key="Brush.LogFg" Color="#FFC9D1D9"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#FF34D399"/>

    <!-- Typography -->
    <FontFamily x:Key="Font.Main">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
